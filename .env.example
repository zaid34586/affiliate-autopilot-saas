# 🔐 Environment Variables — copy this to .env.local and fill values
# NEVER commit .env.local to git

# ---- App ----
APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# ---- OAuth Apps ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=          # management API token (local only)
DATABASE_URL=postgresql://postgres.<ref>:<pass>@aws-1-<region>.pooler.supabase.com:5432/postgres

# ---- GitHub / Vercel (CI & deploy, local only) ----
GITHUB_TOKEN=
VERCEL_TOKEN=

# ---- AI Providers (Phase 3+) ----
OPENAI_API_KEY=
GEMINI_API_KEY=                 # platform pool (video engine)
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=

# ---- Payments (Phase 3) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Storage ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---- Observability ----
SENTRY_DSN=
