{
  "name": "affiliate-autopilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @aa/db generate",
    "db:migrate": "pnpm --filter @aa/db migrate",
    "db:seed": "pnpm --filter web seed",
    "smoke": "pnpm --filter web smoke"
  },
  "engines": {
    "node": ">=20"
  }
}
