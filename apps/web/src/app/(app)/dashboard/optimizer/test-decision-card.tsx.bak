interface DashboardData {
  config: OptimizerConfig;
  recentDecisions: Decision[];
  pendingDecisions: Decision[];
  stats: { totalPosts: number; boosted: number; paused: number; remixed: number; abTests: number };
}

export default function TestComponent() {
  return <DecisionCard decision={{ id: "1", decisionType: "boost", targetId: "test", targetType: "post", reason: "test", confidence: 80, metadata: {}, executed: false, executedAt: null, result: null, createdAt: new Date().toISOString() }} onExecute={() => {}} executing={null} />;
}